{
  "name": "crypto-lab-ciphertext-mirror",
  "private": true,
  "version": "1.0.0",
  "description": "FO re-encryption as oracle: three papers, three replays. ML-KEM attack/defense visualizations.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "author": "Paul Clark <paul@systemslibrarian.dev>",
  "license": "MIT",
  "keywords": [
    "post-quantum",
    "ml-kem",
    "kyber",
    "side-channel",
    "fo-transform",
    "crypto-lab"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/systemslibrarian/crypto-lab-ciphertext-mirror"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run && node --test tests/publish-request.test.mjs",
    "test:coverage": "vitest run --coverage && node --test tests/publish-request.test.mjs",
    "test:a11y": "playwright test",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "deploy": "gh workflow run deploy-pages.yml --repo systemslibrarian/crypto-lab-ciphertext-mirror --ref main"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
